{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "gestao-pedidos": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/gestao-pedidos",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["src/assets", { "glob": "**/*", "input": "public" }],
            "styles": [
              "src/styles.scss",
              "@angular/material/prebuilt-themes/azure-blue.css"
            ],
            "optimization": { "styles": { "inlineCritical": false, "minify": true }, "fonts": { "inline": false } },
            "budgets": [
              { "type": "initial", "maximumWarning": "2mb", "maximumError": "3mb" },
              { "type": "anyComponentStyle", "maximumWarning": "70kb", "maximumError": "100kb" }
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "dev": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev.ts"
                }
              ],
              "namedChunks": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "gestao-pedidos:build:production"
            },
            "dev": {
              "buildTarget": "gestao-pedidos:build:dev"
            },
            "serve": {
              "buildTarget": "gestao-pedidos:build:serve"
            },
            "development": {
              "buildTarget": "gestao-pedidos:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
